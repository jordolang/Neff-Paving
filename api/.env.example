DB_HOST=localhost
DB_PORT=5432
DB_NAME=neff_paving_admin
DB_USER=postgres
DB_PASSWORD=your_password
JWT_SECRET=your_secret_key
NODE_ENV=development
PORT=3000

# ── Mobile apps API (/api/v1) ───────────────────────────────────────────────
# Owner account: always super admin in all three companies (enforced on every start).
SUPER_ADMIN_EMAIL=owner@example.com
# Comma-separated; granted admin once by `npm run seed:admins` (e.g. Clint and Austin).
ADMIN_EMAILS=clint@example.com,austin@example.com
# 32-byte key (64 hex chars) encrypting employee bank numbers. Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Google sign-in: comma-separated OAuth client IDs the apps use (iOS + Android/web server IDs).
GOOGLE_CLIENT_IDS=
# Public origin used to build absolute media URLs (e.g. https://api.neffpaving.com).
PUBLIC_BASE_URL=
# Where photo/video uploads are stored on disk (defaults to api/uploads).
UPLOAD_DIR=
COMPANY_TIMEZONE=America/New_York
TRACKING_PING_SECONDS=60
# Optional: Stripe Checkout for customer card payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Optional: POST target that relays notifications to APNs/FCM (see api/README.md).
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
# Optional: password-reset emails (same Resend account as the website forms).
RESEND_API_KEY=
FORM_FROM_EMAIL=
PASSWORD_RESET_URL=
# Estimated withholding rate applied in payroll runs (0.0–1.0). Real tax filing stays with your payroll provider.
PAYROLL_WITHHOLDING_RATE=0
